{
    "include": [
        "."
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        ".vscode",
        "venv",
        "env"
    ],
    "venvPath": ".",
    "venv": "env",
    "pythonVersion": "3.11",
    "pythonPlatform": "Darwin",
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true,
    "reportMissingImports": false,
    "reportOptionalMemberAccess": false
}
